# Example: xyz123abc-1.a1.typesense.net (no https:// prefix)
TYPESENSE_HOST=
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https

# A scoped search-only key used by the local search proxy.
TYPESENSE_SEARCH_KEY=

# Required only by `npm run typesense:setup`; never sent to the browser.
TYPESENSE_ADMIN_KEY=
TYPESENSE_COLLECTION=dogs
CAT_TYPESENSE_COLLECTION=cats

# Alternatively, place a Typesense Cloud *-api-keys-*.txt export in the project root.
# The newest export is loaded automatically and remains ignored by Git.

# Optional. The importer uses the NPS public DEMO_KEY when omitted.
NPS_API_KEY=
